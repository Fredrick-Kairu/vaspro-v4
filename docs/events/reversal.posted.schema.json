{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.vaspro.io/events/reversal.posted.schema.json",
  "title": "reversal.posted",
  "description": "Published by the ledger when an approved reversal's entries are posted (task 3.7). from_main_minor came from the main wallet (negative when a clawback's rounding overshot and the main wallet was credited back); clawback lists the unused tokens taken back per service wallet. status is payback_pending when the money waits in reversal clearing for the rail, posted for a chargeback or operator reversal. Billing consumes it for the credit note. No VAT moves: top-ups carry none. This is the envelope's data field, not the whole envelope (see platform/events.Envelope).",
  "type": "object",
  "required": [
    "tenant_id",
    "reversal_id",
    "original_transaction_id",
    "kind",
    "currency",
    "amount_minor",
    "transaction_id",
    "status",
    "from_main_minor",
    "clawback"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "reversal_id": {
      "type": "string",
      "format": "uuid"
    },
    "original_transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "payback",
        "chargeback",
        "operator"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "posted",
        "payback_pending"
      ]
    },
    "from_main_minor": {
      "type": "integer"
    },
    "clawback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service_code",
          "tokens",
          "value_minor"
        ],
        "additionalProperties": false,
        "properties": {
          "service_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "tokens": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
          },
          "value_minor": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": false
}
