{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.vaspro.io/events/reversal.requested.schema.json",
  "title": "reversal.requested",
  "description": "Published by the ledger when a staff member raises a reversal of a client's top-up (system design §4.3, task 3.7, OQ-18). Nothing is posted until a different staff member approves it; clawback_services are the service wallets the maker named to claw unused tokens back from, in order. This is the envelope's data field, not the whole envelope (see platform/events.Envelope).",
  "type": "object",
  "required": [
    "tenant_id",
    "reversal_id",
    "original_transaction_id",
    "kind",
    "currency",
    "amount_minor",
    "reason",
    "requested_by",
    "clawback_services"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "reversal_id": {
      "type": "string",
      "format": "uuid"
    },
    "original_transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "payback",
        "chargeback",
        "operator"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "format": "uuid"
    },
    "clawback_services": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "evidence_document_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false
}
