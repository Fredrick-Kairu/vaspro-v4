{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.vaspro.io/events/reversal.approved.schema.json",
  "title": "reversal.approved",
  "description": "Published by the ledger when a staff member other than the maker approves a reversal, with a fresh step-up, and a finance lead's approval at or above the country pack's threshold (task 3.7). reversal.posted follows in the same transaction. This is the envelope's data field, not the whole envelope (see platform/events.Envelope).",
  "type": "object",
  "required": [
    "tenant_id",
    "reversal_id",
    "original_transaction_id",
    "kind",
    "currency",
    "amount_minor",
    "requested_by",
    "approved_by",
    "finance_lead_required"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "reversal_id": {
      "type": "string",
      "format": "uuid"
    },
    "original_transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "payback",
        "chargeback",
        "operator"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1
    },
    "requested_by": {
      "type": "string",
      "format": "uuid"
    },
    "approved_by": {
      "type": "string",
      "format": "uuid"
    },
    "finance_lead_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
