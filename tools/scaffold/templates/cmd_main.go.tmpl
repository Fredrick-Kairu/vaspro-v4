package main

import (
	"context"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"github.com/Fredrick-Kairu/vaspro-v4/internal/{{.Name}}"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	svc, err := {{.Name}}.Bootstrap(ctx)
	if err != nil {
		slog.Error("{{.Name}}: bootstrap", "error", err)
		os.Exit(1)
	}

	if err := svc.Run(ctx); err != nil {
		slog.Error("{{.Name}}: exited with error", "error", err)
		os.Exit(1)
	}
}
