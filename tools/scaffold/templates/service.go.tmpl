package {{.Name}}

import (
	"context"
	"fmt"
	"log/slog"
	"net"
	"net/http"
	"time"

	"github.com/Fredrick-Kairu/vaspro-v4/internal/platform/bus"
	"github.com/Fredrick-Kairu/vaspro-v4/internal/platform/clock"
	"github.com/Fredrick-Kairu/vaspro-v4/internal/platform/config"
	"github.com/Fredrick-Kairu/vaspro-v4/internal/platform/db"
	"github.com/Fredrick-Kairu/vaspro-v4/internal/platform/httpx"
	"github.com/Fredrick-Kairu/vaspro-v4/internal/platform/outbox"
	"github.com/Fredrick-Kairu/vaspro-v4/internal/platform/server"
	"github.com/Fredrick-Kairu/vaspro-v4/internal/{{.Name}}/api"
	"github.com/Fredrick-Kairu/vaspro-v4/internal/{{.Name}}/app"
)

// Config is {{.Name}}'s process configuration (platform/config.Load).
// DatabaseURL's connection must resolve unqualified table names to the
// {{.Name}} schema — either the connecting role's default search_path is
// set at provisioning time, or the DSN includes search_path={{.Name}}
// explicitly; platform/outbox and platform/inbox query unqualified
// table names and rely on it.
type Config struct {
	DatabaseURL string `env:"{{.Upper}}_DATABASE_URL,required"`
	NATSURL     string `env:"{{.Upper}}_NATS_URL,required"`
	HTTPAddr    string `env:"{{.Upper}}_HTTP_ADDR" envDefault:":8080"`
}

// Service wires {{.Name}}'s dependencies together and runs them.
type Service struct {
	cfg  Config
	pool *db.Pool
	bus  *bus.Bus
	app  *app.Service
	rtr  http.Handler
}

// New builds a Service from already-connected dependencies. Bootstrap is
// the usual entry point; New exists separately so tests can build a
// Service against testkit's containers without going through it.
func New(cfg Config, pool *db.Pool, b *bus.Bus) *Service {
	a := app.New(pool, clock.Real{})
	rtr := api.Routes(a, slog.Default(), []httpx.Check{
		func(ctx context.Context) error { return pool.Ping(ctx) },
	})
	return &Service{cfg: cfg, pool: pool, bus: b, app: a, rtr: rtr}
}

// Bootstrap loads Config from the environment and connects every
// dependency New needs — the only thing cmd/{{.Name}} and cmd/vaspro-all
// have to call.
func Bootstrap(ctx context.Context) (*Service, error) {
	cfg := config.MustLoad[Config]()

	pool, err := db.NewPool(ctx, cfg.DatabaseURL)
	if err != nil {
		return nil, fmt.Errorf("{{.Name}}: connecting to database: %w", err)
	}
	b, err := bus.Connect(ctx, cfg.NATSURL)
	if err != nil {
		return nil, fmt.Errorf("{{.Name}}: connecting to nats: %w", err)
	}
	return New(cfg, pool, b), nil
}

// Router is {{.Name}}'s HTTP handler, exported so tests can drive it
// with httptest without a real listener.
func (s *Service) Router() http.Handler { return s.rtr }

func (s *Service) relaySubject(eventType string) string { return "{{.Name}}." + eventType }

// HandleWidgetCreated applies one delivery of a {{.Name}}.widget_created
// event exactly once (platform/inbox). Exported so tests can call it
// directly to prove a redelivery is a no-op.
func (s *Service) HandleWidgetCreated(ctx context.Context, data []byte) error {
	return app.ApplyWidgetCreated(ctx, s.pool, data)
}

// Run starts {{.Name}}'s HTTP server, event consumer and outbox relay
// loop, and blocks until ctx is cancelled, then shuts down gracefully
// (platform/server.Serve).
func (s *Service) Run(ctx context.Context) error {
	const stream = "{{.Upper}}_EVENTS"
	if err := s.bus.EnsureStream(ctx, stream, []string{"{{.Name}}.>"}); err != nil {
		return fmt.Errorf("{{.Name}}: ensuring stream: %w", err)
	}

	cc, err := s.bus.Consume(ctx, bus.ConsumeConfig{
		Stream:        stream,
		Durable:       "{{.Name}}-widgets",
		FilterSubject: "{{.Name}}.widget_created",
		AckWait:       10 * time.Second,
		MaxDeliver:    5,
	}, s.HandleWidgetCreated)
	if err != nil {
		return fmt.Errorf("{{.Name}}: starting consumer: %w", err)
	}
	defer cc.Stop()

	relay := outbox.NewRelay(s.pool, s.bus, s.relaySubject)
	relayDone := make(chan struct{})
	go func() {
		defer close(relayDone)
		ticker := time.NewTicker(500 * time.Millisecond)
		defer ticker.Stop()
		for {
			select {
			case <-ctx.Done():
				return
			case <-ticker.C:
				_, _ = relay.RelayOnce(ctx)
			}
		}
	}()

	ln, err := net.Listen("tcp", s.cfg.HTTPAddr)
	if err != nil {
		return fmt.Errorf("{{.Name}}: listening on %s: %w", s.cfg.HTTPAddr, err)
	}

	srv := &http.Server{Handler: s.rtr, ReadHeaderTimeout: 5 * time.Second}
	err = server.Serve(ctx, srv, ln, 10*time.Second)
	<-relayDone
	return err
}
