# VASPRO dev environment on the host's shared nginx
# (docs/runbooks/dev-environment.md). Rendered by render.sh; don't edit
# the rendered copy by hand except through certbot --nginx, which adds the
# 443 listeners, certificates and the HTTP-to-HTTPS redirect.
#
# Both sites proxy to the dev stack's loopback-only ports. Everything here
# is named vaspro_* or scoped to these two server names, so it can't clash
# with the other project's sites.

# Upgrade headers for Mailpit's live UI (WebSocket). Named, not the common
# $connection_upgrade, in case another site already defines that map.
map $http_upgrade $vaspro_connection_upgrade {
    default upgrade;
    ''      close;
}

# The API: the gateway. Bodies up to the gateway's largest limit (a 10 MB
# document plus 1 MB of multipart framing). X-Forwarded-For is replaced,
# never appended, so a client can't add addresses of its own; the gateway
# trusts it only from the address Docker forwards loopback traffic from.
server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    client_max_body_size 11m;

    location / {
        proxy_pass http://127.0.0.1:${GATEWAY_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# Mailpit's web UI and API, where testers read verification codes.
server {
    listen 80;
    listen [::]:80;
    server_name ${MAIL_DOMAIN};

    auth_basic "VASPRO dev mail";
    auth_basic_user_file /etc/nginx/.htpasswd-vaspro-mail;

    location / {
        proxy_pass http://127.0.0.1:${MAILPIT_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vaspro_connection_upgrade;
        proxy_read_timeout 1h;
    }
}
