# Copy this file to .env in this same directory and adjust if you like.
# The local stack (docker-compose.yml) uses only the infrastructure block.
# The dev environment (docker-compose.dev.yml) uses all of it: run
# deploy/compose/dev-secrets.sh to create .env with every secret filled
# in. Values here are development defaults, never production ones.
# See docs/runbooks/dev-environment.md.

# --- Infrastructure -------------------------------------------------------

POSTGRES_USER=vaspro
POSTGRES_PASSWORD=vaspro
POSTGRES_DB=vaspro

RABBITMQ_USER=vaspro
RABBITMQ_PASSWORD=vaspro

CLICKHOUSE_USER=vaspro
CLICKHOUSE_PASSWORD=vaspro
CLICKHOUSE_DB=vaspro

# Object storage keys: must match seaweedfs-s3.json (local-only identity).
OBJECT_STORAGE_ACCESS_KEY=vaspro-local
OBJECT_STORAGE_SECRET_KEY=vaspro-local-secret

# --- Dev environment: database roles (db-setup.sh) ------------------------
# One owner (runs migrations) and one login role per service. These end up
# inside connection URLs, so keep them URL-safe (dev-secrets.sh uses hex).

IDENTITY_OWNER_PASSWORD=
IDENTITY_DB_PASSWORD=
ACCOUNTS_OWNER_PASSWORD=
ACCOUNTS_DB_PASSWORD=
LEDGER_OWNER_PASSWORD=
LEDGER_DB_PASSWORD=

# --- Dev environment: published port --------------------------------------

# host:port (or port) the gateway is published on; the only published port.
GATEWAY_PUBLISH=8081

# --- gateway (internal/gateway Config) ------------------------------------

GATEWAY_HTTP_ADDR=:8081
GATEWAY_IDENTITY_BASE_URL=http://identity:8080
GATEWAY_IDENTITY_GRPC_ADDR=identity:9090
GATEWAY_ACCOUNTS_BASE_URL=http://accounts:8082
GATEWAY_LEDGER_BASE_URL=http://ledger:8083
GATEWAY_REDIS_URL=redis://redis:6379/1
# Exact browser origins allowed to call the API, comma-separated, no
# wildcard. Empty: no CORS headers at all.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Spec paths inside the image; the defaults are right.
# GATEWAY_IDENTITY_OPENAPI_PATH=docs/api/identity.yaml
# GATEWAY_ACCOUNTS_OPENAPI_PATH=docs/api/accounts.yaml
# GATEWAY_LEDGER_OPENAPI_PATH=docs/api/ledger.yaml

# --- identity (internal/identity Config) ----------------------------------

# IDENTITY_DATABASE_URL is built by docker-compose.dev.yml from
# IDENTITY_DB_PASSWORD (role identity_app, search_path identity,public).
IDENTITY_HTTP_ADDR=:8080
IDENTITY_GRPC_ADDR=:9090
IDENTITY_NATS_URL=nats://nats:4222
IDENTITY_REDIS_URL=redis://redis:6379/0
IDENTITY_ACCOUNTS_GRPC_ADDR=accounts:9091
IDENTITY_SMTP_ADDR=mailpit:1025
IDENTITY_EMAIL_FROM=no-reply@vaspro.io
# Secrets: base64 of exactly 32 random bytes each (dev-secrets.sh).
# Changing the two KMS keys makes existing TOTP secrets and signing keys
# unreadable: reset the environment instead.
IDENTITY_TOTP_KMS_KEY=
IDENTITY_SIGNING_KEYS_KMS_KEY=
IDENTITY_CHALLENGE_SIGNING_KEY=
# Passkeys: the dashboard's domain, and its exact origins (comma-separated).
IDENTITY_WEBAUTHN_RP_ID=localhost
IDENTITY_WEBAUTHN_RP_DISPLAY_NAME=VASPRO (dev)
IDENTITY_WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:5173
# Sign in with Google: leave the client ID empty to turn it off.
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_SECRET=
IDENTITY_GOOGLE_REDIRECT_URL=
IDENTITY_GOOGLE_ISSUER=https://accounts.google.com

# --- accounts (internal/accounts Config) ----------------------------------

# ACCOUNTS_DATABASE_URL is built by docker-compose.dev.yml from
# ACCOUNTS_DB_PASSWORD (role accounts_app, search_path accounts,public).
ACCOUNTS_HTTP_ADDR=:8082
ACCOUNTS_GRPC_ADDR=:9091
ACCOUNTS_NATS_URL=nats://nats:4222
ACCOUNTS_IDENTITY_GRPC_ADDR=identity:9090
ACCOUNTS_KYC_PROVIDER=fake
ACCOUNTS_KYC_FAKE_URL=http://kyc-vendor:8090
# Shared with the fake vendor (KYCVENDOR_WEBHOOK_SECRET is set from it).
ACCOUNTS_KYC_WEBHOOK_SECRET=
ACCOUNTS_OBJECT_STORAGE_ENDPOINT=object-storage:8333
# ACCOUNTS_OBJECT_STORAGE_ACCESS_KEY / _SECRET_KEY come from
# OBJECT_STORAGE_ACCESS_KEY / _SECRET_KEY above.
ACCOUNTS_OBJECT_STORAGE_BUCKET=documents
ACCOUNTS_OBJECT_STORAGE_USE_TLS=false
# Secret: base64 of exactly 32 random bytes (dev-secrets.sh).
ACCOUNTS_DOCUMENTS_KMS_KEY=
ACCOUNTS_CLAMAV_ADDR=clamav:3310
ACCOUNTS_PACKS_DIR=packs

# --- ledger (internal/ledger Config) --------------------------------------

# LEDGER_DATABASE_URL is built by docker-compose.dev.yml from
# LEDGER_DB_PASSWORD (role ledger_app, search_path ledger,public).
LEDGER_HTTP_ADDR=:8083
LEDGER_GRPC_ADDR=:9092
LEDGER_NATS_URL=nats://nats:4222
LEDGER_IDENTITY_GRPC_ADDR=identity:9090
LEDGER_SETTLEMENT_WINDOW=5m
LEDGER_PACKS_DIR=packs

# --- fake KYC vendor (tools/fakes/kycvendor/cmd/kycvendor) ----------------

KYCVENDOR_ADDR=:8090
# Where results are posted: accounts' webhook, through the gateway.
KYCVENDOR_WEBHOOK_URL=http://gateway:8081/v1/accounts/kyc/webhooks/fake
# Base of the hosted-flow links the fake hands out.
KYCVENDOR_PUBLIC_URL=http://kyc-vendor:8090
