# Dev environment front door (docs/runbooks/dev-environment.md): TLS,
# certificates obtained and renewed automatically into /data. Each site's
# DNS must point at this host, with ports 80 and 443 open, for a public
# certificate; *.localhost names get Caddy's own local CA instead.

# The API. Bodies are capped at the gateway's own largest limit (a 10 MB
# document plus 1 MB of multipart framing, internal/gateway/bodylimit.go),
# so anything bigger stops here. Caddy sets X-Forwarded-For to the
# client's address, which the gateway trusts from this container only
# (GATEWAY_TRUSTED_PROXIES).
{$API_DOMAIN} {
	request_body {
		max_size 11MiB
	}
	reverse_proxy gateway:8081
}

# Mailpit's web UI and API, where testers read verification codes.
{$MAIL_DOMAIN} {
	basic_auth {
		{$MAIL_BASIC_AUTH_USER} {$MAIL_BASIC_AUTH_HASH}
	}
	reverse_proxy mailpit:8025
}
